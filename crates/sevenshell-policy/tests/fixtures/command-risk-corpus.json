{
  "note": "Behaviour lock for the command risk classifier. Every case states the level it must have and the rule ids that must have fired; a case that fails means a rule was removed, weakened, or made noisier, and that is a decision to make on purpose. Cases carry a note exactly where the level is a judgement call rather than an obvious reading.",
  "cases": [
    { "command": "ls -la /var/www", "level": "safe", "reasons": [] },
    { "command": "df -h", "level": "safe", "reasons": [] },
    { "command": "uptime", "level": "safe", "reasons": [] },
    { "command": "docker ps --format '{{.Names}}'", "level": "safe", "reasons": [] },
    { "command": "ss -tulpn", "level": "safe", "reasons": [] },
    { "command": "du -sh /var/log", "level": "safe", "reasons": [] },
    { "command": "tail -f /var/log/syslog", "level": "safe", "reasons": [] },
    { "command": "systemctl status nginx", "level": "safe", "reasons": [] },
    { "command": "systemctl restart nginx", "level": "safe", "reasons": [], "note": "A restart is routine and reversible; only stopping, disabling or masking is flagged." },
    { "command": "cat /etc/nginx/nginx.conf", "level": "safe", "reasons": [] },
    { "command": "journalctl -u nginx --since '1 hour ago' --no-pager", "level": "safe", "reasons": [] },
    { "command": "ps aux --sort=-%mem | head -20", "level": "safe", "reasons": [], "note": "A pipe into something harmless: the classifier looks for a shell on the right of the pipe, not any pipe." },
    { "command": "nohup /opt/app/bin/serve --port 8080 > /dev/null 2>&1 &", "level": "safe", "reasons": [], "note": "nohup is a wrapper and /dev/null is not a file being overwritten." },
    { "command": "env APP_ENV=prod /opt/app/bin/serve", "level": "safe", "reasons": [], "note": "The assignment belongs to env, so the program is what follows it." },
    { "command": "awk -F: '{print $1}' /etc/passwd", "level": "safe", "reasons": [], "note": "A flag at the start belongs to the program; there is no wrapper to attribute it to." },

    { "command": "echo \"rm -rf /\"", "level": "safe", "reasons": [], "note": "Quoted text is data. This is the false positive that would make the whole warning worthless." },
    { "command": "printf 'mkfs.ext4 /dev/sda'", "level": "safe", "reasons": [] },
    { "command": "grep -rn \"rm -rf /\" /var/log", "level": "safe", "reasons": [] },
    { "command": "mysql -e \"drop database staging\"", "level": "safe", "reasons": [], "note": "The statement inside the quotes is not what this command line does to the shell." },
    { "command": "echo 'hello' > /dev/null", "level": "safe", "reasons": [] },
    { "command": "echo hello > /tmp/notes.txt", "level": "caution", "reasons": ["overwrite-file"] },
    { "command": "git commit -m 'rm -rf /tmp'", "level": "safe", "reasons": [] },

    { "command": "sudo systemctl restart nginx", "level": "caution", "reasons": ["privilege-elevation"] },
    { "command": "sudo -u deploy /srv/app/restart.sh", "level": "caution", "reasons": ["privilege-elevation"], "note": "The flag takes a value, so the program is restart.sh and not deploy." },
    { "command": "sudo -u root systemctl stop nginx", "level": "caution", "reasons": ["privilege-elevation", "service-control"] },
    { "command": "systemctl stop nginx", "level": "caution", "reasons": ["service-control"] },
    { "command": "systemctl disable --now firewalld", "level": "caution", "reasons": ["service-control"] },
    { "command": "chmod 777 /var/www/html", "level": "caution", "reasons": ["permissions-wide-open"] },
    { "command": "chmod -R 777 /srv/app/uploads", "level": "caution", "reasons": ["permissions-wide-open"], "note": "Recursive into a named directory is not broad enough for the destructive level; world-writable still is caution." },
    { "command": "chown -R deploy:deploy /srv/app", "level": "safe", "reasons": [], "note": "-R alone is not a risk: it takes a broad path as well." },
    { "command": "apt-get remove --purge nginx", "level": "caution", "reasons": ["package-removal"] },
    { "command": "dnf remove httpd", "level": "caution", "reasons": ["package-removal"] },
    { "command": "git reset --hard origin/main", "level": "caution", "reasons": ["version-control-destructive"] },
    { "command": "git push --force origin main", "level": "caution", "reasons": ["version-control-destructive"] },
    { "command": "git clean -fdx", "level": "caution", "reasons": ["version-control-destructive"] },
    { "command": "bash -c \"$MAINTENANCE_COMMAND\"", "level": "caution", "reasons": ["unreadable-shell"], "note": "A shell is the program, so the words after it are not the command that runs." },
    { "command": "sh -c 'uptime'", "level": "caution", "reasons": ["unreadable-shell"] },
    { "command": "sudo bash -c \"systemctl stop nginx\"", "level": "caution", "reasons": ["privilege-elevation", "unreadable-shell"], "note": "sudo is skipped to find bash, so the unreadable-shell rule still sees the program." },
    { "command": "passwd deploy", "level": "caution", "reasons": ["user-change"] },
    { "command": "userdel -r olduser", "level": "caution", "reasons": ["user-change"] },
    { "command": "history -c", "level": "caution", "reasons": ["history-rewrite"] },
    { "command": "crontab -r", "level": "caution", "reasons": ["scheduled-work-removal"], "note": "Removes the account's scheduled work; -l and -e are left alone." },

    { "command": "rm -rf /tmp/build", "level": "destructive", "reasons": ["recursive-force-delete"], "note": "Recursive forced delete of a named path: destructive, but the path is not everything." },
    { "command": "rm -rf ./node_modules", "level": "destructive", "reasons": ["recursive-force-delete"] },
    { "command": "sudo rm -rf /srv/app/tmp", "level": "destructive", "reasons": ["privilege-elevation", "recursive-force-delete"], "note": "Wrappers do not hide the program; the elevated level is the worst of the rules." },
    { "command": "nice -n 5 rm -rf /srv/cache", "level": "destructive", "reasons": ["recursive-force-delete"], "note": "-n takes the value, so rm is still found." },
    { "command": "rm -rf /tmp/build/*", "level": "catastrophic", "reasons": ["recursive-force-delete", "delete-everything"], "note": "A /* glob is every entry in that directory. Judgement call: the level is the one that always asks, because the wrong directory name deletes the wrong tree." },
    { "command": "rm -rf /", "level": "catastrophic", "reasons": ["recursive-force-delete", "delete-everything"] },
    { "command": "rm -rf /*", "level": "catastrophic", "reasons": ["recursive-force-delete", "delete-everything"] },
    { "command": "rm -rf ~", "level": "catastrophic", "reasons": ["recursive-force-delete", "delete-everything"] },
    { "command": "chown -R deploy:deploy /", "level": "destructive", "reasons": ["recursive-permissions"] },
    { "command": "chmod -R 755 /etc", "level": "safe", "reasons": [], "note": "/etc is not a broad path in the sense this rule means: it is a named directory, and the rule reserves itself for the root and the home." },
    { "command": "find /var/tmp -name '*.tmp' -delete", "level": "destructive", "reasons": ["delete-files-by-find"] },
    { "command": "killall5", "level": "destructive", "reasons": ["kill-everything"] },
    { "command": "kill -1 1", "level": "destructive", "reasons": ["kill-everything"] },
    { "command": "kill -9 12345", "level": "safe", "reasons": [], "note": "Killing one process by pid is routine; only the signal-everything shapes are flagged." },
    { "command": "shutdown -h now", "level": "destructive", "reasons": ["power-state"] },
    { "command": "reboot", "level": "destructive", "reasons": ["power-state"] },
    { "command": "iptables -F", "level": "destructive", "reasons": ["firewall-flush"] },
    { "command": "ufw disable", "level": "destructive", "reasons": ["firewall-flush"] },
    { "command": "truncate -s 0 /var/log/nginx/access.log", "level": "destructive", "reasons": ["erase-logs"] },
    { "command": "rm -f /var/log/nginx/*.log", "level": "destructive", "reasons": ["erase-logs"] },

    { "command": "mkfs.ext4 /dev/sdb1", "level": "catastrophic", "reasons": ["filesystem-format"] },
    { "command": "dd if=/dev/zero of=/dev/sda bs=4M", "level": "catastrophic", "reasons": ["write-to-device"] },
    { "command": "curl -fsSL https://example.com/install.sh | bash", "level": "catastrophic", "reasons": ["network-code-as-root"] },
    { "command": "wget -qO- https://example.com/setup | sudo sh", "level": "catastrophic", "reasons": ["network-code-as-root"], "note": "The shell is reached through a pipe and a wrapper; both are followed." },
    { "command": "curl -fsSL https://example.com/data.json -o /tmp/data.json", "level": "safe", "reasons": [], "note": "Downloading a file is not handing a shell a script." },
    { "command": "echo 'drop table users' | mysql production", "level": "safe", "reasons": [], "note": "The SQL is quoted, so it is data here: the classifier reads the words that run, and those are echo, mysql and production. Reading inside quotes is what makes such a warning worth ignoring." },
    { "command": "psql -c 'drop database prod'", "level": "safe", "reasons": [], "note": "Same reason: quoted SQL is not classified." },
    { "command": "rm -rf /etc && sudo systemctl restart nginx", "level": "destructive", "reasons": ["recursive-force-delete", "privilege-elevation"], "note": "/etc is a named directory, so this is not delete-everything; the level still comes from the worst rule." },
    { "command": "rm -rf /var/log/*", "level": "catastrophic", "reasons": ["recursive-force-delete", "delete-everything", "erase-logs"] },
    { "command": "", "level": "safe", "reasons": [] },
    { "command": "   ", "level": "safe", "reasons": [] }
  ]
}
