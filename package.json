{
  "name": "sevenshell",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "7Shell - an open-source SSH and operations console.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "dev:tauri": "tauri dev",
    "build": "vite build --config apps/desktop/vite.config.ts",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pretypecheck": "pnpm generate:descriptors",
    "typecheck": "vue-tsc --noEmit --project apps/desktop/tsconfig.json",
    "generate:descriptors": "node scripts/sync-descriptors.mjs",
    "check:descriptors": "node scripts/sync-descriptors.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "sync:versions": "node scripts/reconcile-versions.mjs",
    "verify:versions": "node scripts/reconcile-versions.mjs --check",
    "release:notes": "node scripts/release-notes.mjs",
    "test:guards": "node --test \"scripts/tests/*.test.mjs\"",
    "test:scripts": "node --test scripts/",
    "lint": "oxlint apps/desktop/src e2e",
    "fmt": "oxfmt \"apps/desktop/src/**/*.{ts,vue}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\" \"docs/.vitepress/**/*.{ts,mts}\"",
    "fmt:check": "oxfmt --check \"apps/desktop/src/**/*.{ts,vue}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\" \"docs/.vitepress/**/*.{ts,mts}\"",
    "pretest": "pnpm generate:descriptors",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/run-check.mjs",
    "app:e2e": "node scripts/e2e-app.mjs",
    "screenshots": "node scripts/e2e-app.mjs --config e2e/playwright.capture.config.ts",
    "icons": "node scripts/generate-icon.mjs && tauri icon art/icon.png",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "1.17.0",
    "@vueuse/core": "^14.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^3.0.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3",
    "yaml": "2.8.4"
  },
  "lint-staged": {
    "apps/desktop/src/**/*.{ts,vue}": "oxfmt --no-error-on-unmatched-pattern",
    "scripts/**/*.mjs": "oxfmt --no-error-on-unmatched-pattern"
  }
}
