# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Documentation site: the VitePress build output and its cache.
/docs/.vitepress/cache
/docs/.vitepress/dist

# Package manager manifests, written per release from the files that release built.
/packaging/out/

# Rust
/target/
src-tauri/target/
src-tauri/gen/
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# End-to-end run output: the throwaway data directory and the screenshots it took.
/e2e/.run/
/e2e/artifacts/
/e2e/test-results/

# Local scratch (never published)
# ---------------------------------------------------------------------------
# Local planning notes and drafts. Kept out of version control on purpose.
/.planning/
/.scratch/

# Local-only configuration and rules files. Never commit these.
*.local.json
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
