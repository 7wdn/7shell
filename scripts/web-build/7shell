#!/bin/bash
# Starts the local 7Shell service and opens the system browser. No install step, no root.
set -u

ROOT="$(cd "$(dirname "$0")" && pwd)"
export LD_LIBRARY_PATH="$ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export SEVENSHELL_CONFIG_DIR="${SEVENSHELL_CONFIG_DIR:-$ROOT/data}"
export SEVENSHELL_WEB_STATIC="$ROOT/dist"

port_free() {
  ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

PORT="${SEVENSHELL_WEB_PORT:-4225}"
for candidate in $(seq "$PORT" $((PORT + 20))); do
  if port_free "$candidate"; then
    PORT="$candidate"
    break
  fi
done

TOKEN="${SEVENSHELL_WEB_TOKEN:-$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | cut -c1-32)}"
URL="http://127.0.0.1:${PORT}/?token=${TOKEN}"
export SEVENSHELL_WEB_PORT="$PORT"
export SEVENSHELL_WEB_TOKEN="$TOKEN"

echo "7Shell 浏览器版"
echo "  界面地址: $URL"
echo "  数据目录: $SEVENSHELL_CONFIG_DIR"
echo "  按 Ctrl+C 停止服务"
echo

(
  sleep 1
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1
  elif command -v sensible-browser >/dev/null 2>&1; then
    sensible-browser "$URL" >/dev/null 2>&1
  elif command -v x-www-browser >/dev/null 2>&1; then
    x-www-browser "$URL" >/dev/null 2>&1
  fi
) &

exec "$ROOT/bin/sevenshell-web"