# Everything is stored with LF in the repository; Git converts on checkout where needed.
* text=auto eol=lf

# Windows scripts keep CRLF so they run in cmd.exe / PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted.
*.ico binary
*.icns binary
*.png binary
*.jpg binary
*.zip binary
